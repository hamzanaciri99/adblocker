{
  "background": {
    "service_worker": "background/index.js"
  },
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "webNavigation",
    "tabs",
    "declarativeNetRequest"
  ],
  "web_accessible_resources": [
    {
      "resources": ["surrogates/*"],
      "matches": ["http://*/*", "https://*/*"],
      "use_dynamic_url": true
    }
  ]
}
