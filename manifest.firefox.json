{
  "background": {
    "scripts": [
      "background/index.js"
    ]
  },
  "permissions": [
    "storage",
    "scripting",
    "webNavigation",
    "tabs",
    "webRequest",
    "webRequestBlocking"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "umbra@umbra.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "surrogates/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
